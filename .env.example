# MongoDB Atlas connection. Copy this file to .env.local and fill in your URI.
# .env.local is gitignored — never commit real credentials.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"

# Database name to use within the cluster. Defaults to "analytics" if unset.
MONGODB_DB="analytics"

# Coarse IP geolocation (Necessary tier). Path to a MaxMind GeoLite2-City .mmdb file.
# The DB is licensed and not committed — download it with a free MaxMind license key (see
# README). If unset/missing, geo lookups degrade gracefully to "unknown".
GEOIP_DB_PATH="./data/GeoLite2-City.mmdb"

# Used only at Docker build time to download GeoLite2 into the image (see Dockerfile).
# MAXMIND_LICENSE_KEY="your-free-license-key"
